# Elegí "openai", "local" u "openrouter".
MODEL_MODE=openai

# OpenAI (solo se usa cuando MODEL_MODE=openai).
OPENAI_API_KEY=<tu-clave-openai>
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Modelos locales con LM Studio (solo se usan cuando MODEL_MODE=local).
# Cargá un modelo de chat y también un modelo de embeddings en LM Studio.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LOCAL_CHAT_MODEL=<modelo-chat-cargado-en-lm-studio>
LOCAL_EMBEDDING_MODEL=<modelo-embeddings-cargado-en-lm-studio>

# OpenRouter (solo se usa cuando MODEL_MODE=openrouter).
# OpenRouter ofrece chat y embeddings mediante una API compatible con OpenAI.
OPENROUTER_API_KEY=<tu-clave-openrouter>
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Qdrant local: iniciar antes con "docker compose up -d qdrant".
QDRANT_URL=http://localhost:6333

# Pinecone: nombre exacto del índice que ya creaste en Pinecone Cloud.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=quickstart
PINECONE_NAMESPACE=clase-rag
# Debe coincidir con la dimensión del índice. Ejemplo: 512 para el índice "henry".
PINECONE_EMBEDDING_DIMENSIONS=512

# Weaviate Cloud crea y borra una colección temporal.
WEAVIATE_URL=
WEAVIATE_API_KEY=
