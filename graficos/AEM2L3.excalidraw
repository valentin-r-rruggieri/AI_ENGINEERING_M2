      "boundElements": [],
      "updated": 1785797561830,
      "link": null,
      "locked": false,
      "text": "RAG no reemplaza al LLM — lo complementa con evidencia privada, actualizada y verificable.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RAG no reemplaza al LLM — lo complementa con evidencia privada, actualizada y verificable.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f1",
      "type": "text",
      "x": 60,
      "y": 4734,
      "width": 615.989501953125,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#5B21B6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5m",
      "roundness": null,
      "seed": 2112128881,
      "version": 3,
      "versionNonce": 987989323,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785797561830,
      "link": null,
      "locked": false,
      "text": "Si el pipeline de datos falla, el pipeline de consulta no puede recuperar info confiable.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si el pipeline de datos falla, el pipeline de consulta no puede recuperar info confiable.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f2",
      "type": "text",
      "x": 60,
      "y": 4756,
      "width": 537.28466796875,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#5B21B6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5n",
      "roundness": null,
      "seed": 639542303,
      "version": 3,
      "versionNonce": 2063239397,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785797561830,
      "link": null,
      "locked": false,
      "text": "El threshold debe calibrarse con datos reales, no elegirse arbitrariamente.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El threshold debe calibrarse con datos reales, no elegirse arbitrariamente.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f3",
      "type": "text",
